# DJANGO_SECRET_KEY è obbligatoria quando DJANGO_DEBUG non è True (senza, l'app non parte).
DJANGO_SECRET_KEY=cambia-questa-chiave-con-uno-secrets.token_urlsafe(64)
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=gestionale.aigislab.ai,217.154.67.95,localhost,127.0.0.1
SITE_BASE_URL=https://gestionale.aigislab.ai
# Origini fidate per il CSRF dietro nginx/HTTPS (con schema).
DJANGO_CSRF_TRUSTED_ORIGINS=https://gestionale.aigislab.ai

# HTTPS: con DEBUG=False cookie secure e HSTS (1 anno) sono attivi di default.
# DJANGO_SESSION_COOKIE_SECURE=true
# DJANGO_CSRF_COOKIE_SECURE=true
# DJANGO_SECURE_HSTS_SECONDS=31536000
# Il redirect 80→443 lo fa nginx; attivalo anche in Django se serve.
# DJANGO_SECURE_SSL_REDIRECT=false
# Location interna nginx per i media protetti (X-Accel-Redirect).
# DJANGO_MEDIA_ACCEL=/media-protetti/

# IP del client per l'audit da X-Forwarded-For (dietro nginx; default true se DEBUG=False).
# AUDIT_TRUST_X_FORWARDED_FOR=true

# Webhook: invio in background (default true); IP privati solo in sviluppo.
# WEBHOOK_IN_BACKGROUND=true
# WEBHOOK_CONSENTI_IP_PRIVATI=false
# IDEMPOTENZA_ORE=24

# Email (opzionali — se non impostati, i messaggi vanno solo a stdout in DEBUG)
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=true
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# DEFAULT_FROM_EMAIL=Gestionale CRM <noreply@aigislab.ai>
