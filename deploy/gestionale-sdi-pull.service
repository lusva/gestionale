[Unit]
Description=Gestionale CRM (AIGIS lab) - notifiche SDI e fatture passive dalla PEC
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=root
WorkingDirectory=/opt/gestionale-crm
EnvironmentFile=/opt/gestionale-crm/.env
ExecStart=/opt/gestionale-crm/venv/bin/python manage.py sdi_pull
